{
  "name": "semantic-diff",
  "displayName": "Semantic Diff",
  "description": "Clause-based semantic diff and staging for prose in git. The meaningful unit of change is the clause, not the line.",
  "version": "0.1.0",
  "publisher": "semantic-diff",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": ["*"],
  "contributes": {
    "commands": [
      {
        "command": "semanticDiff.openDiff",
        "title": "Semantic Diff: Open Semantic Diff"
      },
      {
        "command": "semanticDiff.stageHunk",
        "title": "Semantic Diff: Stage Selected Semantic Hunk"
      },
      {
        "command": "semanticDiff.stageAll",
        "title": "Semantic Diff: Stage All Semantic Hunks"
      },
      {
        "command": "semanticDiff.toggleProjection",
        "title": "Semantic Diff: Toggle Semantic Projection"
      },
      {
        "command": "semanticDiff.openHistoricalDiff",
        "title": "Semantic Diff: Open Semantic Diff Between Commits…",
        "icon": "$(git-commit)"
      },
      {
        "command": "semanticDiff.toggleSplitPane",
        "title": "Semantic Diff: Toggle Split/Inline View",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "semanticDiff.toggleClauseNumbers",
        "title": "Semantic Diff: Toggle Clause Numbers in Editor"
      },
      {
        "command": "semanticDiff.stageAllFiles",
        "title": "Semantic Diff: Stage All Changes in All Files"
      },
      {
        "command": "semanticDiff.nextChange",
        "title": "Semantic Diff: Go to Next Change"
      },
      {
        "command": "semanticDiff.prevChange",
        "title": "Semantic Diff: Go to Previous Change"
      },
      { "command": "semanticDiff.stageMove", "title": "Semantic Diff: Stage Move" },
      { "command": "semanticDiff.splitMove", "title": "Semantic Diff: Split Move into Delete + Insert" },
      { "command": "semanticDiff.ignoreMove", "title": "Semantic Diff: Ignore Move" },
      { "command": "semanticDiff.unignoreMove", "title": "Semantic Diff: Unignore Move" },
      {
        "command": "semanticDiff.openBookDiff",
        "title": "Semantic Diff: Open Book Diff (bookdown / quarto)",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "semanticDiff.openHistoricalDiff",
          "when": "semanticDiff.diffActive",
          "group": "navigation"
        },
        {
          "command": "semanticDiff.toggleSplitPane",
          "when": "semanticDiff.diffActive",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "semanticDiff.nextChange",
        "key": "alt+]",
        "when": "editorTextFocus"
      },
      {
        "command": "semanticDiff.prevChange",
        "key": "alt+[",
        "when": "editorTextFocus"
      },
      {
        "command": "semanticDiff.stageHunk",
        "key": "alt+s",
        "when": "editorTextFocus && semanticDiff.diffActive"
      }
    ],
    "configuration": {
      "title": "Semantic Diff",
      "properties": {
        "semanticDiff.conjunctionMinLength": {
          "type": "number",
          "default": 60,
          "description": "Minimum clause length (characters) before a break is inserted ahead of a coordinating conjunction."
        },
        "semanticDiff.ignoreOrderedListNumbering": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, changes to ordered-list sequence numbers (1. → 2., etc.) are not treated as meaningful clause changes. Item text changes are still surfaced normally."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "tsc -p . && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
